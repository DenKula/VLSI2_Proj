# synth_bitrev.ys

# Read the Verilog source
read_verilog rtl/user_domain/bit_rev/bitrev.sv

# Set top-level module
hierarchy -top bitrev

# Optional: remove or simplify problematic memory
# Avoid visualizing SRAM as individual signals
# You can skip this if not needed for visualization:
# blackbox sram   ;# <-- only if SRAM is a module, not a variable

# Do basic preparation
prep -top bitrev

# OPTIONAL: generate pre-synthesis schematic excluding sram signal
# You can use 'select -list' to show only the datapath parts if needed
select -clear
select -add t:bitrev
select -del %sram

# Generate SVG (not dot, avoids Graphviz issue)
show \
  -format svg \
  -prefix bitrev \
  -color \
  -viewer none

# Now run synthesis steps
proc; opt; fsm; opt; memory; opt; flatten; opt;
