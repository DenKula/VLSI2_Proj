read_verilog rtl/user_domain/bit_rev/bitrev.sv

# Prevent memory from becoming individual registers
memory -nomap

# Prepare the top module
prep -top bitrev

# Lower always blocks into logic
proc

# Clear selection, then add just the top module
select -clear
select -add t:bitrev

# Hide large arrays and memory nets
select -del n:*sram*
select -del n:*[*
select -del n:*data*
select -del n:*q*

# Show diagram without flattened sram
show -width -format dot -prefix bitrev
