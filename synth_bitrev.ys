# Read your RTL
read_verilog rtl/user_domain/bit_rev/bitrev.sv

# Top module setup
prep -top bitrev

# Optional: write to JSON if needed for other tools
# write_json bitrev.json

# Clean current selection
select -clear

# Select everything in the top module
select -add bitrev

# Deselect the huge memory to avoid DOT graph overflow
select -del *sram*

# Generate graph (will output bitrev.dot and launch xdot or GTKWave depending on config)
show -width -format dot -prefix bitrev
