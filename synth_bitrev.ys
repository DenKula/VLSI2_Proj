read_verilog rtl/user_domain/bit_rev/bitrev.sv
prep -top bitrev

# Avoid visualizing huge signal arrays
select -clear
select -add t:bitrev
select -del n:sram[*]

# If needed, exclude all signals matching sram*
select -del n:sram*

# Generate the graph (dot + svg)
show -width -format dot -prefix bitrev
