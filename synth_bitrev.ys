# Load the design
read_verilog rtl/user_domain/bit_rev/bitrev.sv

# Keep inferred memories as abstract cells (not flattened into registers)
memory -nomap

# Prepare for synthesis
prep -top bitrev

# Compile behavioral processes
proc

# Clear previous selection
select -clear

# Select only the top module
select -add t:bitrev

# Optionally, remove overly wide buses from display (flattened logic)
# We now *keep* sram_a and sram_b, so don't exclude them
select -del n:*[1024]    # optional: removes any wide nets if causing clutter
select -del n:*data_i*   # optional
select -del n:*data_o*   # optional

# Show final diagram
show -width -format dot -prefix bitrev
