# Load RTL
read_verilog rtl/user_domain/bit_rev/bitrev.sv

# Prepare design
memory -nomap
prep -top bitrev

# Restrict visualization to avoid massive .dot labels from SRAM
select -clear
select -add t:bitrev
select -del n:*sram*


# Generate a safe, viewable graph
show -width -format dot -prefix bitrev
